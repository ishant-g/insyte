# ============================================================================
# Insyte — Passive Exposure Intelligence
# Environment configuration. Copy to .env and adjust for your deployment.
# The core platform runs with every value below left at its default —
# every external provider is optional.
# ============================================================================

# ---- Application ------------------------------------------------------
APP_NAME=Insyte
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# ---- CORS (comma separated, exact origins — never *) -------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- HTTPS / transport security -----------------------------------------
# Enable only once Insyte is actually served over HTTPS.
ENABLE_HSTS=false

# ---- Database (PostgreSQL only) -----------------------------------------
DATABASE_URL=postgresql+psycopg://insyte:insyte@postgres:5432/insyte
POSTGRES_USER=insyte
POSTGRES_PASSWORD=insyte
POSTGRES_DB=insyte

# ---- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ---- Collection limits ----------------------------------------------------
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=10.0
HTTP_TOTAL_TIMEOUT=20.0
HTTP_MAX_REDIRECTS=3
HTTP_MAX_RESPONSE_BYTES=5242880
HTTP_MAX_CONCURRENCY=6
MAX_URLS_PER_SCAN=5000
MAX_JS_FILES_PER_SCAN=60
MAX_PAGES_PER_SCAN=25
MAX_SUBDOMAINS_PER_SCAN=5000

# ---- Data / reports --------------------------------------------------------
DATA_DIR=/var/lib/insyte
REPORT_RETENTION_DAYS=30

# ---- Optional external intelligence providers ------------------------------
# Every one of these is optional. Insyte's core scan is fully functional
# with all of them left blank — a provider without a key simply reports
# itself unavailable and the scan continues.
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=
GITHUB_TOKEN=
URLSCAN_API_KEY=
OTX_API_KEY=
# Free tier: 1000 IP reputation checks/day. Unlocks abuse-confidence
# scoring on discovered IP addresses.
ABUSEIPDB_API_KEY=
# Free registration at cloud.projectdiscovery.io. Unlocks the Chaos
# subdomain dataset.
CHAOS_API_KEY=
# Free "Registered" tier at grayhatwarfare.com. Unlocks open cloud-bucket
# exposure search.
GRAYHATWARFARE_API_KEY=
# Optional. The GreyNoise Community API answers unauthenticated requests
# at a reduced rate limit — a free key at greynoise.io raises it.
GREYNOISE_API_KEY=
# Free registration token at opencorporates.com (anonymous access to the
# search API was retired). Unlocks best-effort company-name matching.
OPENCORPORATES_API_TOKEN=
# Paid subscription key at haveibeenpwned.com/api-key — as of HIBP's 2024
# terms there is no free tier. Unlocks breach-metadata lookups (never
# passwords) for harvested emails and the target domain.
HIBP_API_KEY=
# Free tier: 25 searches/month at hunter.io. Unlocks domain-scoped email
# discovery and Hunter's inferred email-naming pattern.
HUNTER_API_KEY=
# Free tier: 100 queries/day. Create a search engine at
# programmablesearchengine.google.com (set it to search the whole web) for
# the CX value, and an API key at console.cloud.google.com. Both are
# required; unlocks the Google Dorking module.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ---- CVE intelligence -------------------------------------------------------
# The NVD API works without a key at a reduced rate (5 requests / 30s).
# A free key from https://nvd.nist.gov/developers/request-an-api-key raises
# this substantially and is recommended for anything beyond occasional use.
NVD_API_KEY=
CVE_LOOKUP_ENABLED=true

# ---- Frontend build (compose only) -----------------------------------------
# Browser-facing API URL, baked into the frontend build at image-build
# time. Leave unset for a standard localhost docker compose deployment.
INSYTE_PUBLIC_API_URL=http://localhost:8000

# ---- Authentication / accounts -----------------------------------------
# SECRET_KEY signs session JWTs AND derives the at-rest encryption key for
# stored per-account provider credentials. Generate a strong random value
# for any non-local deployment: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
# Rotating it invalidates all sessions and all stored provider keys by design.
SECRET_KEY=insyte-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Set to false to close self-service registration (seed/invite accounts only).
ALLOW_REGISTRATION=true
